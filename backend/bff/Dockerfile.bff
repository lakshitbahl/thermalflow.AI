FROM node:20-alpine
WORKDIR /app
COPY package.json ./
# No lockfile is committed, so `npm ci` cannot be used. `npm install --omit=dev`
# resolves prod deps fresh. For reproducible prod builds, commit package-lock.json
# and switch this back to `npm ci --omit=dev`.
RUN npm install --omit=dev
COPY server.js ./
EXPOSE 8080
CMD ["node", "server.js"]
