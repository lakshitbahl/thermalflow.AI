# ─────────────────────────────────────────────────────────────
#  ThermalFlow — Environment Variables
#  cp .env.example .env  then edit before running `make up`
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_USER=thermalflow
DB_PASSWORD=thermalflow
DB_NAME=thermalflow

# ── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-256bit

# ── Frontend (optional — leave blank for same-host auto-detect) ──
# VITE_WS_URL=wss://your-domain.io          # WebSocket origin
# VITE_PLANT_API=http://your-host:8090      # plant-sim fault API
# VITE_RELAY_API=http://your-host:8091      # safety-relay reset API
# VITE_ACTUATION_MODE=SHADOW                # dashboard badge only (SHADOW|ACTIVE)
